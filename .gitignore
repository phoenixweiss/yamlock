# Dependencies and build output (root and website)
node_modules/
dist/

# Local agent instructions and working notes
AGENTS.md
*.tmp.md

# Secrets and local configuration; safe examples remain trackable
.env
.env.*
!.env.example
*.local

# Explicit yamlock migration backups and npm package archives
*.yamlock.bak
*.tgz

# OS metadata, logs and Node.js diagnostic reports
.DS_Store
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test coverage and browser reports
coverage/
*.lcov
.nyc_output/
website/playwright-report/
website/test-results/

# Tool caches
.cache/
.npm/
.eslintcache
*.tsbuildinfo
.node_repl_history
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Yarn state; keep reusable Yarn configuration trackable
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
