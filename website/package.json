{
  "name": "yamlock-website",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "node scripts/verify-content.mjs",
    "release:check": "node scripts/release-check.mjs",
    "output:check": "node scripts/verify-output.mjs",
    "test:browser": "playwright test",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "check": "yarn run lint && yarn run format:check && yarn run content:check && yarn run build && yarn run output:check",
    "check:full": "yarn run check && yarn run test:browser && yarn run lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "vite": "8.3.8",
    "vue-eslint-parser": "10.4.2"
  }
}
